# Hugging Face token (needed only if the model requires auth).
# RedHatAI/Qwen3.8-27B-INT4 (default) is public; set a token only if you
# switch to a gated checkpoint.
export HF_TOKEN=hf_YourTokenHere

# Optional: Cloudflare tunnel token for exposing the gateway publicly.
# Leave unset for local-only usage.
export CF_TUNNEL_TOKEN=
