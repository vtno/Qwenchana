# LiteLLM gateway config - copy to .env (same directory) and edit, then from
# the repo root: docker compose up -d litellm --force-recreate
#
# Consumed by the litellm service in ../docker-compose.yml (env_file).

# vLLM backend - in-network vllm service (all-in-one compose).
# When vLLM runs on the host instead (./serve.sh), use:
# VLLM_BASE_URL=http://host.docker.internal:8000/v1
# VLLM_ANTHROPIC_BASE_URL=http://host.docker.internal:8000
VLLM_BASE_URL=http://vllm:8000/v1
# vLLM origin WITHOUT the /v1 suffix - used by the Claude Code
# (Anthropic Messages API) passthrough entry, which appends /v1/messages.
VLLM_ANTHROPIC_BASE_URL=http://vllm:8000
VLLM_API_KEY=EMPTY
VLLM_MODEL_ID=unsloth/Qwen3.8-27B-NVFP4

# Gateway model exposure (base = fast/no thinking; effort variants: low/mid/high/xhigh)
LITELLM_MODEL_NAME=qwen3.8-27b
LITELLM_MODEL_NAME_LOW=qwen3.8-27b-low
LITELLM_MODEL_NAME_MID=qwen3.8-27b-mid
LITELLM_MODEL_NAME_HIGH=qwen3.8-27b-high
LITELLM_MODEL_NAME_XHIGH=qwen3.8-27b-xhigh
LITELLM_LOGLEVEL=INFO

# Admin - REQUIRED before exposing outside localhost.
# Use strong random values (e.g. `openssl rand -hex 16`).
LITELLM_MASTER_KEY=changeme-strong-random-key
UI_USERNAME=admin
UI_PASSWORD=changeme-strong-password

# Database (postgres service in ../docker-compose.yml).
# The password in DATABASE_URL must match POSTGRES_PASSWORD there
# (internal-only; the db service exposes no port).
DATABASE_URL=postgresql://litellm:litellm-pg@db:5432/litellm

# Redis (redis service in ../docker-compose.yml) - used for rate limits, budget
# counters, and cross-pod coordination. Referenced by general_settings.
# coordination_redis.url in config.template.yaml.
REDIS_URL=redis://redis:6379
